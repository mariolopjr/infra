[core]
pager = delta
untrackedCache = true
fsmonitor = true
[user]
signingkey = ~/.ssh/id_ed25519.pub
email = mariolopjr@users.noreply.github.com
name = Mario
[gpg]
format = ssh
[gpg "ssh"]
allowedSignersFile = ~/.ssh/allowed_signers
[commit]
gpgsign = true
[pull]
rebase = true
[tag]
gpgsign = true
[init]
defaultBranch = main
[push]
autoSetupRemote = true
[diff]
tool = difftastic
[difftool]
prompt = false
[difftool "difftastic"]
cmd = difft "$LOCAL" "$REMOTE"
[pager]
difftool = true
[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true
[diff "hex"]
textconv = hexdump -v -C
binary = true
